# PostgreSQL SIRT
POSTGRES_HOST=10.64.1.47
POSTGRES_PORT=5432
POSTGRES_DB=sirt
POSTGRES_USER=acceso
POSTGRES_PASSWORD="su_clave"
POSTGRES_SSL=false

# SMTP
SMTP_HOST=mail.colbeef.com.co
SMTP_PORT=465
SMTP_USER=no-responder-sirt@colbeef.com.co
SMTP_PASSWORD="su_clave_smtp"
SMTP_USE_TLS=false
SMTP_FROM=no-responder-sirt@colbeef.com.co
SMTP_FROM_NAME=Verificacion Precios Cortes SIRT

# Destinatarios cuando hay discrepancias (separados por coma)
REPORT_TO=desarrollo.tecnologia@colbeef.com
REPORT_NOTIFY_TO=desarrollo.tecnologia@colbeef.com

# Ventana de verificación (días hacia atrás desde hoy)
DIAS_VERIFICACION=7

# Diferencia mínima en pesos para alertar (ej: 1 = $1)
TOLERANCIA_PRECIO=1

# Solo alertar si el precio de lista es mayor a 0 (true/false)
IGNORAR_PRECIO_LISTA_CERO=true

# Tipo de factura a verificar
TIPO_FACTURA=Venta Carne

# Programación diaria (hora Colombia)
CRON_SCHEDULE=30 7 * * *
TIMEZONE=America/Bogota

# Si true, también envía correo cuando todo está OK
NOTIFICAR_SI_OK=false

# Validador OD (web)
PORT=3050
ACCESS_PIN=0199
ACCESS_SECRET=cambia-este-secreto
